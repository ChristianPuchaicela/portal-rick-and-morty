      "name": "1. Portada y paginación",
      "item": [
        {
          "name": "Portada y primera página",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta es HTML\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
                  "});",
                  "pm.test(\"Portada, búsqueda y tarjetas iniciales\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"Portal de personajes de Rick and Morty\");",
                  "  pm.expect(pm.response.text()).to.include(\"Busca un personaje por su ID\");",
                  "  pm.expect(pm.response.text()).to.include(\"href=\\\"/personaje/1\\\"\");",
                  "  pm.expect(pm.response.text()).to.include(\"Rick Sanchez\");",
                  "  pm.expect(pm.response.text()).to.include(\"href=\\\"/?page=2\\\"\");",
                  "});",
                  "pm.test(\"La paginación marca la página activa\", () => {",
                  "  const page = 1;",
                  "  pm.expect(pm.response.text()).to.match(new RegExp('aria-current=\"page\">\\\\s*' + page + '\\\\s*<'));",
                  "});",
                  "pm.test(\"El catálogo publica la cantidad de páginas\", () => {",
                  "  const html = pm.response.text().replace(/<!--[^]*?-->/g, \"\");",
                  "  const pagination = html.match(/Página 1 de (\\d+) · (\\d+) personajes/);",
                  "  pm.expect(pagination, \"Indicador del catálogo\").not.to.equal(null);",
                  "  pm.expect(Number(pagination[1])).to.be.greaterThan(1);",
                  "  pm.expect(Number(pagination[2])).to.be.greaterThan(20);",
                  "  pm.collectionVariables.set(\"lastPage\", pagination[1]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "response": []
        },
