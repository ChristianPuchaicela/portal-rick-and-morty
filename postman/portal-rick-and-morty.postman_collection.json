    {
      "name": "4. API de resumen",
      "item": [
        {
          "name": "Resumen válido de Rick Sanchez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La respuesta es JSON\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"El resumen contiene tres oraciones y los seis datos de la ficha\", () => {",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.sentences).to.be.an(\"array\").with.lengthOf(3);",
                  "  for (const sentence of result.sentences) {",
                  "    pm.expect(sentence).to.be.a(\"string\");",
                  "    pm.expect(sentence.trim()).not.to.be.empty;",
                  "  }",
                  "  pm.expect(result.facts).to.be.an(\"array\").with.lengthOf(6);",
                  "  const facts = Object.fromEntries(result.facts.map(({ label, value }) => [label, value]));",
                  "  pm.expect(facts).to.have.all.keys(\"Nombre\", \"Especie\", \"Estado\", \"Origen\", \"Última ubicación\", \"Apariciones\");",
                  "  pm.expect(facts.Nombre).to.equal(\"Rick Sanchez\");",
                  "  pm.expect(result.sentences[0]).to.include(facts.Nombre);",
                  "  pm.expect(result.sentences[2]).to.match(new RegExp(\"\\\\b\" + facts.Apariciones + \"\\\\b\"));",
                  "});",
                  "pm.test(\"El origen es válido y coincide con el modo exigido, si se configuró\", () => {",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.source).to.be.oneOf([\"gemini\", \"simulated\"]);",
                  "  const expected = pm.variables.get(\"expectedSummarySource\");",
                  "  if (expected) pm.expect(result.source).to.equal(expected);",
                  "  if (result.source === \"simulated\") pm.expect(result.notice).to.be.a(\"string\").and.not.be.empty;",
                  "  console.info(\"Origen del resumen:\", result.source);",
                  "});",
                  "pm.test(\"El resumen indica que no debe almacenarse en caché\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
